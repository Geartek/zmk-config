/*
* Custom Corne / BÉPO 1.1rc2
*
* BASE : BÉPO personnalisé
* SYM  : programmation
* NAV  : navigation physique
*/

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define SYM  1
#define NAV  2

/ {
   behaviors {

      /*
      * Enter / SYM
      *
      * tap  -> Enter
      * hold -> SYM
      */
      enter_sym: enter_sym {
         compatible = "zmk,behavior-hold-tap";
         #binding-cells = <2>;

         flavor = "tap-preferred";
         tapping-term-ms = <220>;

         bindings = <&mo>, <&kp>;
      };

      /*
      * GUI / AltGr
      *
      * tap  -> GUI
      * hold -> Right Alt
      */
      gui_altgr: gui_altgr {
         compatible = "zmk,behavior-hold-tap";
         #binding-cells = <2>;

         flavor = "hold-preferred";
         tapping-term-ms = <180>;

         bindings = <&kp>, <&kp>;
      };

      /*
      * $ = Shift + AltGr + 4
      *
      * Nous gardons ce caractère dans une macro
      * car il n'a pas de touche physique dédiée dans
      * notre Corne.
      */
      dollar: dollar {
         compatible = "zmk,behavior-macro";
         #binding-cells = <0>;

         wait-ms = <40>;
         tap-ms = <40>;

         bindings
         = <&macro_press &kp LSHIFT>
         , <&macro_press &kp RALT>
         , <&macro_tap &kp N4>
         , <&macro_release &kp RALT>
         , <&macro_release &kp LSHIFT>
         ;
      };
    };

    keymap {

        compatible = "zmk,keymap";

        /*
         * ============================================================
         * BASE
         * ============================================================
         *
         *       GAUCHE                         DROITE
         *
         *   Tab   B   É   P   O   È       ^   V   D   L   J   W
         *   Esc   A   U   I   E   ,       C   T   S   R   N   M
         *  Shift  À   Y   X   .   K       ’   Q   G   H   F   Z
         *
         *        Ctrl  Backspace Space   Enter/SYM NAV GUI/AltGr
         */

        base {
            display-name = "BASE";

            bindings = <

                /* L01-L06 */
                &kp TAB
                &kp Q
                &kp W
                &kp E
                &kp R
                &kp T

                /* R01-R06 */
                &kp Y
                &kp U
                &kp I
                &kp O
                &kp P
                &kp RIGHT_BRACKET

                /* L07-L12 */
                &kp ESC
                &kp A
                &kp S
                &kp D
                &kp F
                &kp G

                /* R07-R12 */
                &kp H
                &kp J
                &kp K
                &kp L
                &kp SEMICOLON
                &kp APOS

                /* L13-L18 */
                &kp LSHIFT
                &kp Z
                &kp X
                &kp C
                &kp V
                &kp B

                /* R13-R18 */
                &kp N
                &kp M
                &kp COMMA
                &kp PERIOD
                &kp SLASH
                &kp LEFT_BRACKET

                /* pouces gauche */
                &kp LCTRL
                &kp BACKSPACE
                &kp SPACE

                /* pouces droit */
                &enter_sym SYM RET
                &mo NAV
                &gui_altgr RALT LGUI
            >;
        };


        /*
         * ============================================================
         * SYM
         * ============================================================
         *
         *       GAUCHE                         DROITE
         *
         *    1   2   3   4   5   6       7   8   9   0   =   !
         *    (   [   {   <   \   &       |   +   -   *   _   ;
         *    )   ]   }   >   /   |       &   :   =   ?   ~   $
         */

        sym {
            display-name = "SYM";

            bindings = <

                /* L01-L06 : 1 2 3 4 5 6 */
                &kp LS(N1)
                &kp LS(N2)
                &kp LS(N3)
                &kp LS(N4)
                &kp LS(N5)
                &kp LS(N6)

                /* R01-R06 : 7 8 9 0 = ! */
                &kp LS(N7)
                &kp LS(N8)
                &kp LS(N9)
                &kp LS(N0)
                &kp EQUAL
                &kp LS(Y)

                /* L07-L12 : ( [ { < \ & */
                &kp N4
                &kp RA(N4)
                &kp RA(X)
                &kp RA(N2)
                &kp RA(Z)
                &kp RA(E)

                /* R07-R12 : | + - * _ ; */
                &kp RA(B)
                &kp LS(N7)
                &kp LS(N8)
                &kp LS(N9)
                &kp RA(LS(B))
                &kp LS(G)

                /* L13-L18 : ) ] } > / | */
                &kp N5
                &kp RA(N5)
                &kp RA(C)
                &kp RA(N3)
                &kp RA(O)
                &kp RA(B)

                /* R13-R18 : & : = ? ~ $ */
                &kp RA(E)
                &kp LS(V)
                &kp EQUAL
                &kp LS(N)
                &kp RA(K)
                &dollar

                /* pouces gauche */
                &trans
                &trans
                &trans

                /* pouces droit */
                &trans
                &trans
                &trans
            >;
        };


        /*
         * ============================================================
         * NAV
         * ============================================================
         *
         * Les quatre touches de repos de la main droite :
         *
         *              T   S   R   N
         *              ←   ↓   ↑   →
         *
         * Home / PgUp / PgDn / End à gauche.
         */

        nav {
            display-name = "NAV";

            bindings = <

                /* L01-L06 */
                &trans
                &kp HOME
                &kp PG_UP
                &kp PG_DN
                &kp END
                &trans

                /* R01-R06 */
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans

                /* L07-L12 */
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans

                /* R07-R12
                 *
                 * C   T   S   R   N   M
                 *     ←   ↓   ↑   → 
                 */
                &trans
                &kp LEFT
                &kp DOWN
                &kp UP
                &kp RIGHT
                &trans

                /* L13-L18 */
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans

                /* R13-R18 */
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans

                /* pouces gauche */
                &trans
                &trans
                &trans

                /* pouces droit */
                &trans
                &trans
                &trans
            >;
        };
    };
};
