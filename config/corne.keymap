 *
 * Bépo layout for Corne (3x6+3), tuned for EN/FR text, C, and Vim.
 *
 * Base layer = standard BÉPO 1.1 (NF Z71-300) with 3 deliberate deviations
 * (see the Bepo layer comment below): ESC takes over Shift's old spot
 * (Shift is still one hold away, same key), W takes over Ç's old spot,
 * Ç is dropped.
 *
 * AltGr now lives on the right thumb. BÉPO's own AltGr table maps onto our
 * 36 base keys (verified from keys_fr_bepo.h), so holding it while tapping
 * a base letter already gives you | & ` \ { } ´ ¨ æ ß etc. "for free" -
 * that's why the old separate number layer and symbol layer collapse into
 * one merged "Sym" layer here: real Shift, held together with that
 * layer, reproduces genuine BÉPO number-row behaviour (bare key = symbol,
 * +Shift = digit), so one row does the job that used to need two.
 *
 * No host-side vimrc remap here on purpose: real Vim hjkl/w/b/g-motions
 * stay untouched (typed via their real BÉPO physical position) so there's
 * one mental model - the character you type is the command, full stop.
 * The Vim layer below only sends universal arrows/Home/End/PgUp/PgDn and
 * gg/dd/yy macros (plain literal keystrokes), so it never relabels a real
 * Vim command - safe to use anywhere without fighting muscle memory.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "keys_fr_bepo.h"


/ {
    macros {
      ctrl_alt: ctrl_alt {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings
          = <&sk LCTRL &sk LALT>;
      };

      // Vim-layer conveniences: these send literal keystrokes, so they only
      // do the described thing inside an actual Vim/Vim-emulation normal
      // mode (they're plain text elsewhere).
      vim_gg: vim_gg {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&kp G &kp G>;
      };
      vim_dd: vim_dd {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&kp D &kp D>;
      };
      vim_yy: vim_yy {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&kp Y &kp Y>;
      };
    };

    behaviors {
      hm: homerow-mods {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        tapping-term-ms = <175>;
        flavor = "tap-preferred";
        quick-tap-ms = <125>;
        global-quick-tap;
        bindings = <&kp>,<&kp>;
      };

      slt: spacebar_layer_tap {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "balanced";
        tapping-term-ms = <175>;
        require-prior-idle-ms = <100>;
        bindings = <&mo>, <&kp>;
      };

      mhm: lgui_mods {
          compatible = "zmk,behavior-hold-tap";
          #binding-cells = <2>;
          flavor = "balanced";
          tapping-term-ms = <200>;
          quick-tap-ms = <200>; // Double tapping -> hold key
          require-prior-idle-ms = <100>;
          bindings = <&kp>, <&kp>;
      };
    };

    conditional-layers {
      compatible = "zmk,conditional-layers";
      tri_layer {
        // Holding both thumb layers at once (Sym + Vim) reaches Func.
        if-layers = <1 3>;
        then-layer = <2>;
      };
    };

    keymap {
      compatible = "zmk,keymap";

      Bepo {
// Standard BÉPO 1.1 letters, with 3 changes from stock:
//  - ESC replaces Shift's spot (tap = ESC, hold = Shift - nothing is lost)
//  - W moves to Ç's old spot (bottom-right pinky), plain V takes its place
//  - Ç is dropped
// Everything else - all 30 core letters - is untouched, so muscle memory
// for the letters stays exactly where it already is.
// ╭──────┬─────┬─────┬─────┬─────┬─────╮   ╭─────┬─────┬─────┬─────┬─────┬─────╮
// │  TAB │  B  │  É  │  P  │  O  │  È  │   │  ^  │  V  │  D  │  L  │  J  │  Z  │
// ├──────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼─────┤
// │ ESC  │  A  │  U  │  I  │  E  │  ,  │   │  C  │  T  │  S  │  R  │  N  │  M  │
// ├──────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼─────┤
// │ CTRL │  À  │  Y  │  X  │  .  │  K  │   │  '  │  Q  │  G  │  H  │  F  │  W  │
// ╰──────┴─────┴─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┴─────┴─────╯
//                    │ Sym │  ⇧  │ SPC │   │ ENT │AltGr│ VIM │
//                    ╰─────┴─────┴─────╯   ╰─────┴─────┴─────╯
         bindings = <
   &kp TAB       &kp BP_B             &kp BP_E_ACUTE &kp BP_P &kp BP_O     &kp BP_E_GRAVE     &kp BP_CARET &kp BP_V &kp BP_D &kp BP_L &kp BP_J &kp BP_Z
   &kp ESC       &kp BP_A             &kp BP_U       &kp BP_I &kp BP_E     &kp BP_COMMA       &kp BP_C     &kp BP_T &kp BP_S &kp BP_R &kp BP_N &kp BP_M
   &kp LCTRL     &mhm LGUI BP_A_GRAVE &kp BP_Y       &kp BP_X &kp BP_DOT   &kp BP_K           &kp BP_RSQ   &kp BP_Q &kp BP_G &kp BP_H &kp BP_F &kp BP_W
                                                     &mo 1    &kp LSHIFT   &kp BP_SPACE       &kp RET      &kp RALT &mo 3
         >;
      };

      Bepo_numsym {
// Merged numbers + symbols + nav (was 2 layers, now 1 - see file header).
// Row0 is the whole BÉPO "number row" reproduced with dual-purpose keys:
// tap alone = the symbol shown, tap+Shift = the digit/° shown after the
// slash - exactly how a real BÉPO board's number row behaves.
// { } < > are explicit bare keys per your request (not buried behind
// AltGr) since you'll reach for them constantly in C.
// Arrows stay on cols 6-9 of the home row - the exact physical spot
// QWERTY's H J K L occupy - so this doubles as your everyday (non-Vim)
// mouse-free nav in any app.
// ╭──────┬─────┬─────┬─────┬─────┬─────╮   ╭─────┬─────┬─────┬─────┬─────┬─────╮
// │ $/#  │ "/1 │ «/2 │ »/3 │ (/4 │ )/5 │   │ @/6 │ +/7 │ -/8 │ //9 │ */0 │ =/° │
// ├──────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼─────┤
// │ SHFT │  [  │  ]  │  {  │  }  │ DEL │   │LEFT │DOWN │ UP  │ RGT │HOME │ END │
// ├──────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼─────┤
// │ CTRL │  <  │  >  │  _  │ PGUP│ PGDN│   │     │     │     │     │     │     │
// ╰──────┴─────┴─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┴─────┴─────╯
//                    │ GUI │     │ SPC │   │ ENT │SHFT │LALT │
//                    ╰─────┴─────┴─────╯   ╰─────┴─────┴─────╯
        bindings = <
   &kp BP_DLLR &kp BP_DQT &kp BP_LAQUO &kp BP_RAQUO &kp BP_LPAR &kp BP_RPAR    &kp BP_AT &kp BP_PLUS &kp BP_MINUS &kp BP_FSLH &kp BP_STAR &kp BP_EQUAL
   &kp LSHFT   &kp BP_LBKT &kp BP_RBKT &kp BP_LBRC  &kp BP_RBRC &kp DEL        &kp LEFT  &kp DOWN    &kp UP       &kp RIGHT   &kp HOME    &kp END
   &kp LCTRL   &kp BP_LT   &kp BP_GT   &kp BP_UNDER &kp PG_UP   &kp PG_DN      &trans    &trans      &trans       &trans      &trans      &trans
                                       &kp LGUI     &trans      &kp BP_SPACE  &kp RET    &kp RSHFT   &kp LALT
        >;
      };

      Bepo_func {
// Reached by holding Sym + Vim together (both thumbs).
// ╭──────┬─────┬─────┬─────┬─────┬─────╮   ╭─────┬─────┬─────┬─────┬─────┬─────╮
// │  F1  │  F2 │  F3 │  F4 │ F5  │  F6 │   │  F7 │  F8 │  F9 │ F10 │ F11 │ F12 │
// ├──────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼─────┤
// │ SHFT │v up │prev │pause│next │ BKSP│   │ DEL │LEFT │DOWN │ UP  │ RGT │     │
// ├──────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼─────┤
// │ CTRL │v dn │mute │     │     │     │   │     │     │ PDN │ PUP │     │CALT │
// ╰──────┴─────┴─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┴─────┴─────╯
//                    │LGUI │     │ SPC │   │ ENT │     │ ALT │
//                    ╰─────┴─────┴─────╯   ╰─────┴─────┴─────╯
        bindings = <
   &kp F1    &kp F2       &kp F3     &kp F4   &kp F5     &kp F6        &kp F7  &kp F8   &kp F9    &kp F10   &kp F11   &kp F12
   &kp LSHFT &kp C_VOL_UP &kp C_PREV &kp C_PP &kp C_NEXT &kp BSPC      &kp DEL &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &trans
   &kp LCTRL &kp C_VOL_DN &kp C_MUTE &trans   &trans     &trans        &trans  &trans   &kp PG_DN &kp PG_UP &trans    &sk LA(LCTRL)
                                     &kp LGUI &trans     &kp SPACE     &kp RET &trans   &kp LALT
        >;
      };

      Vim {
// Held from the right thumb. Turns the whole right hand into arrows/word-
// jump/line-jump so mouse-free navigation works even where an app's own
// hjkl bindings assume QWERTY. Left hand keeps Ctrl/Shift/Alt so
// Ctrl+arrow (word jump) and Shift+arrow (select) work one-handed.
// Every binding here is a plain literal keystroke (arrows, or a real Vim
// command autotyped twice by a macro) - nothing here relabels what a key
// means inside real Vim, so it never fights the muscle memory you're
// building for actual Vim motions.
// ╭──────┬─────┬─────┬─────┬─────┬─────╮   ╭─────┬─────┬─────┬─────┬─────┬─────╮
// │ trns │     │     │     │     │     │   │ HOME│ DOWN│  UP │ END │ PGUP│     │
// ├──────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼─────┤
// │ SHFT │     │     │     │     │     │   │ LEFT│ DOWN│  UP │ RGHT│ PGDN│     │
// ├──────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼─────┤
// │ CTRL │     │     │     │     │     │   │  gg │  G  │  dd │  yy │  p  │     │
// ╰──────┴─────┴─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┴─────┴─────╯
//                    │ ALT │     │ SPC │   │ ESC │     │ trns│
//                    ╰─────┴─────┴─────╯   ╰─────┴─────┴─────╯
        bindings = <
   &trans    &trans &trans &trans &trans &trans        &kp HOME &kp DOWN &kp UP  &kp END   &kp PG_UP &trans
   &kp LSHFT &trans &trans &trans &trans &trans        &kp LEFT &kp DOWN &kp UP  &kp RIGHT &kp PG_DN &trans
   &kp LCTRL &trans &trans &trans &trans &trans        &vim_gg  &kp G    &vim_dd &vim_yy   &kp P     &trans
                                  &kp LALT &trans &kp BP_SPACE  &kp ESC  &trans  &trans
        >;
      };
  };
};
